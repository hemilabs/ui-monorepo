# Get a free token at https://envio.dev/app/api-tokens, then copy this file to
# `.env` and paste the token below.
ENVIO_API_TOKEN=

# Optional RPC override for Hemi. Leave unset to use the public RPC
# hard-coded in config.yaml; set this and point config.yaml's Hemi `rpc.url`
# at it for a dedicated/paid endpoint.
HEMI_RPC_URL=

# Optional RPC overrides for the HEMI supply snapshots. Leave unset to use the
# public RPC of each chain.
ENVIO_RPC_URL_BNB=
ENVIO_RPC_URL_ETH=
ENVIO_RPC_URL_HEMI=

ENVIO_SUPPLY_REALTIME_START_BLOCK_BNB=
ENVIO_SUPPLY_REALTIME_START_BLOCK_ETH=
ENVIO_SUPPLY_REALTIME_START_BLOCK_HEMI=
