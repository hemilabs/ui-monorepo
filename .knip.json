{
  "ignore": ["subgraphs/utils/index.ts"],
  "ignoreBinaries": ["jq"],
  "ignoreDependencies": ["eslint-config-prettier"],
  "workspaces": {
    "portal": {
      "typescript": {
        "config": [
          "scripts/hemi-earn/tsconfig.json",
          "server/tsconfig.json",
          "tsconfig.build.json",
          "tsconfig.json"
        ]
      }
    },
    "portal-backend/api": {
      "entry": ["scripts/*.cjs"]
    },
    "subgraphs/*": {
      "entry": ["src/mappings/*.ts"]
    }
  }
}
