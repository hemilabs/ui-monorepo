{
  "ignore": [
    "portal/worker/worker-configuration.d.ts",
    "subgraphs/utils/index.ts"
  ],
  "ignoreBinaries": ["jq"],
  "ignoreDependencies": ["assemblyscript", "eslint-config-prettier"],
  "workspaces": {
    "portal": {
      "typescript": {
        "config": [
          "scripts/hemi-earn/tsconfig.json",
          "worker/tsconfig.json",
          "tsconfig.build.json",
          "tsconfig.json"
        ]
      }
    },
    "portal-backend/api": {
      "entry": ["scripts/*.cjs"]
    },
    "subgraphs/*": {
      "entry": ["src/mappings/*.ts"]
    },
    "subgraphs/ve-hemi-subgraph": {
      "entry": ["src/mappings/*.ts", "tests/**/*.test.ts"]
    }
  }
}
